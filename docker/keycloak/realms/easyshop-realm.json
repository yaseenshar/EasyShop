{
  "realm": "easyshop",
  "enabled": true,
  "displayName": "EasyShop",
  "displayNameHtml": "EASYSHOP",
  "loginTheme": "easyshop",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(10) and notUsername and passwordHistory(3)",
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Standard shopper"
      },
      {
        "name": "VENDOR",
        "description": "Sells products on EasyShop"
      },
      {
        "name": "ADMIN",
        "description": "Platform administrator"
      },
      {
        "name": "SERVICE",
        "description": "Machine-to-machine service account (client credentials)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "easyshop-angular",
      "name": "EasyShop Angular SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "easyshop-gateway",
      "name": "EasyShop API Gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "${env.KEYCLOAK_GATEWAY_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "attributes": {
        "_comment": "directAccessGrantsEnabled=true is a DEV-ONLY concession so curl test scripts can mint user tokens without a browser. Disable outside local - ROPC is removed in OAuth 2.1."
      }
    },
    {
      "clientId": "easyshop-review-service",
      "name": "Review Service (M2M)",
      "enabled": true,
      "publicClient": false,
      "secret": "${env.KEYCLOAK_REVIEW_SERVICE_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "_comment": "Client-credentials-only: no user login flows at all. Exists so review-service can call order-service /internal endpoints with a service-account JWT instead of relying on gateway routing topology as the only protection."
      }
    }
  ],
  "scopeMappings": [],
  "users": [
    {
      "username": "demo.customer",
      "email": "demo.customer@easyshop.test",
      "firstName": "Demo",
      "lastName": "Customer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Customer#Pass1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    },
    {
      "username": "demo.vendor",
      "email": "demo.vendor@easyshop.test",
      "firstName": "Demo",
      "lastName": "Vendor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Vendor#Pass12",
          "temporary": false
        }
      ],
      "realmRoles": [
        "VENDOR"
      ]
    },
    {
      "username": "demo.admin",
      "email": "demo.admin@easyshop.test",
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin#Pass123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "service-account-easyshop-review-service",
      "enabled": true,
      "serviceAccountClientId": "easyshop-review-service",
      "realmRoles": [
        "SERVICE"
      ]
    }
  ]
}