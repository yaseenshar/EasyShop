<!-- easyshop/pom.xml -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.easyshop</groupId>
    <artifactId>easyshop</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>EasyShop</name>

    <!-- Declare all child modules -->
    <modules>
        <module>infrastructure/service-discovery</module>
        <module>infrastructure/api-gateway</module>
        <!-- DISABLED, and it must stay that way while the directory is
             untracked. infrastructure/config-server is not in git, so a fresh
             clone - CI, or any other machine - has no such directory and Maven
             refuses to build the reactor at all: "Child module ... does not
             exist". It also fails `docker compose build`, because no service
             Dockerfile copies this module's pom.

             To re-enable it, the module has to be committed AND added to the
             COPY list in every service Dockerfile, and its scratch classes
             (basic/*, easy/*) either removed or given a single main class, or
             spring-boot-maven-plugin:repackage cannot choose an entry point. -->
        <!-- <module>infrastructure/config-server</module> -->
        <module>common/common-lib</module>
        <module>services/user-service</module>
        <module>services/catalog-service</module>
        <module>services/order-service</module>
        <module>services/payment-service</module>
        <module>services/inventory-service</module>
        <module>services/cart-service</module>
        <module>services/notification-service</module>
        <module>services/review-service</module>
    </modules>

    <!-- Inherit from Spring Boot BOM for dependency version management -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Centralized dependency versions -->
        <resilience4j.version>2.2.0</resilience4j.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <testcontainers.version>1.21.4</testcontainers.version>

        <!-- Container image coordinates, overridden by CI (-Djib.namespace=...).
             The default namespace is a placeholder that does not exist on
             Docker Hub, so a stray `mvn jib:build` fails to authenticate rather
             than publishing somewhere unintended. Local image builds should use
             jib:dockerBuild, which ignores the registry entirely. -->
        <jib.registry>docker.io</jib.registry>
        <jib.namespace>easyshop-local</jib.namespace>
    </properties>

    <!-- dependencyManagement = declare versions here, consume in children without versions -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM — imports the entire Spring Cloud dependency tree -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Resilience4j Spring Boot integration -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <!-- resilience4j-bulkhead: NOT pulled transitively by the fleet-wide
                 spring-cloud-starter-circuitbreaker-resilience4j dependency below
                 (that only drags in -circuitbreaker/-retry/-timelimiter/-core).
                 Any service using @Bulkhead must add this explicitly. Pinned to
                 2.3.0, not ${resilience4j.version} (2.2.0) - that's the version
                 Maven already mediates -circuitbreaker/-retry/-timelimiter/-core
                 to transitively (via resilience4j-spring6's own dependency on
                 newer core modules), so this keeps the bulkhead jar aligned with
                 the rest of the resilience4j stack actually on the classpath
                 instead of silently drifting to a mismatched minor version. -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bulkhead</artifactId>
                <version>2.3.0</version>
            </dependency>
            <!-- MapStruct for DTO↔Entity mapping — compile-time, no reflection -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- Testcontainers BOM for integration tests with real DBs/Kafka -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- EasyShop common library — shared across all services -->
            <dependency>
                <groupId>com.easyshop</groupId>
                <artifactId>common-lib</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Dependencies every child module automatically gets -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- JDK 23+ deprecated implicit (unconfigured) annotation processor
                     discovery on the classpath, and newer JDKs (e.g. 25) no longer run
                     it at all unless processors are explicitly declared. Without this,
                     Lombok silently stops generating getters/setters when building with
                     a JDK newer than what the project targets (release 21), even though
                     lombok is on the compile classpath. Declaring it explicitly here
                     makes annotation processing work regardless of the build JDK. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!-- Jib plugin — builds Docker images without a Docker daemon -->
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>3.4.4</version>
                    <configuration>
                        <from>
                            <!-- Distroless: a JRE and nothing else - no shell,
                                 no package manager, no busybox. Smaller attack
                                 surface, and notably smaller than the
                                 eclipse-temurin base the Dockerfiles use.
                                 (Comment previously said Java 25; the image is
                                 and should stay java21, matching the project's
                                 maven.compiler.release.)

                                 Pulled from gcr.io, which is free and needs no
                                 Google account - only the PUSH target is
                                 Docker Hub. -->
                            <image>gcr.io/distroless/java21-debian12</image>
                        </from>
                        <to>
                            <!-- Parameterised so CI can point this at a real
                                 namespace without editing the pom. Defaults are
                                 deliberately local-only placeholders: pushing
                                 requires -Djib.to.image or these properties, so
                                 nobody accidentally publishes to a stranger's
                                 Docker Hub namespace by running jib:build.

                                 Image names are prefixed (easyshop-cart-service
                                 rather than cart-service) because Docker Hub is
                                 a flat namespace per account - unprefixed names
                                 would collide with anything else you publish. -->
                            <image>${jib.registry}/${jib.namespace}/easyshop-${project.artifactId}:${project.version}</image>
                        </to>
                        <container>
                            <!-- Reproducible builds default Jib's timestamp to
                                 the Unix epoch, which makes every image look 55
                                 years old in `docker images`. USE_CURRENT_TIMESTAMP
                                 trades bit-for-bit reproducibility for a
                                 creation date a human can read when deciding
                                 which image is actually deployed. -->
                            <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        </container>
                    </configuration>
                </plugin>
                <!-- Surefire for unit tests -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <!-- Failsafe for integration tests (@IntegrationTest) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.2</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Plugins that actually RUN in every module, as opposed to the
             pluginManagement block above which only pins versions. -->
        <plugins>
            <!-- JaCoCo coverage.
                 SonarQube's analysis is largely decorative without it: static
                 rules still fire, but every coverage metric and any
                 coverage-based quality gate reads zero, which looks like the
                 project has no tests rather than like coverage was never
                 measured.

                 prepare-agent sets the argLine surefire passes to the JVM.
                 Nothing here overrides argLine (checked - the surefire
                 declaration above sets only a version), so the agent is not
                 silently dropped, which is the usual way this ends up
                 reporting 0%.

                 The report is bound to VERIFY rather than test, so `mvn test`
                 stays as fast as it is today and only the CI job that asks for
                 verification pays for report generation. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>