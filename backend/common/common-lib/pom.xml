<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.easyshop</groupId>
        <artifactId>easyshop</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-lib</artifactId>
    <name>EasyShop Common Libs</name>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- optional=true: needed to compile BaseOutboxEvent/BaseOutboxRepository
             here, but must NOT leak transitively into every consumer. Services
             that use the outbox base classes (order/payment/inventory/review/...)
             already declare spring-boot-starter-data-jpa themselves. Services
             that don't (notification-service, cart-service) would otherwise get
             JPA autoconfiguration pulled in with no DataSource configured. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- OTel API only (not the starter): BaseOutboxEvent captures the
             trace context from a JPA @PrePersist callback, which is not a Spring
             bean and cannot inject a Propagator. Span.current() is the static,
             context-reading API designed for exactly that. Optional so it never
             lands on a consumer that has not asked for tracing - every use site
             degrades to a no-op when the span is absent. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- micrometer-core only (not the whole actuator starter): common-lib
             needs MeterFilter/MeterRegistry to COMPILE the fleet-wide meter
             configuration, but must not force actuator onto a consumer that
             hasn't asked for it. Marked optional so it does not leak onto
             consumers' classpaths; every service already pulls micrometer-core
             transitively via spring-boot-starter-actuator, which is what makes
             MetricsCommonAutoConfiguration's @ConditionalOnClass fire. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JWKS fetch throttling is a behaviour of the real Nimbus/Spring
             decoder against a real HTTP endpoint - the whole question is how
             many times a socket gets opened, which only an actual server can
             answer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

</project>